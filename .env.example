# Last.fm API key — powers the top track, top album, and similar artists.
# Create an API account at https://www.last.fm/api/account/create to get one.
# Copy this file to `.env.local` and replace the dummy values below.
LASTFM_API_KEY=your-lastfm-api-key

# Spotify Web API credentials (Client Credentials flow) — used ONLY to fetch
# artwork (artist photos, track/album covers). Optional: without these the app
# still works, it just shows placeholder icons instead of images. Create an app
# at https://developer.spotify.com/dashboard to obtain them.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
